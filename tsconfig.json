{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "newLine": "lf",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "rootDir": "./src/",
    "strict": true,
    "declaration": true,
    "moduleResolution": "node",
    "module": "commonjs",
    "outDir": "./out/",
    "skipLibCheck": true,
    "target": "es2019",
    "lib": ["es2019", "esnext.disposable"]
  },
  "include": [
    "src/"
  ],
  "exclude": [
    "src/*.web.ts"
  ]
}
