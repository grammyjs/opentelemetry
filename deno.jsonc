{
  "lock": false,
  "imports": {
    "@grammyjs/opentelemetry": "npm:@grammyjs/opentelemetry",
    "@opentelemetry/api": "npm:@opentelemetry/api",
    "grammy": "npm:grammy"
  },
  "exclude": ["dist", ".vscode", ".github"],
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": [
        "no-explicit-any",
        "./deno_cache/",
        "./node_modules/",
        "./out/",
        "./package-lock.json",
        "./bundling/bundles"
      ],
      "include": [
        "explicit-function-return-type",
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "no-console",
        "no-throw-literal",
        "single-var-declarator",
        "verbatim-module-syntax"
      ]
    }
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 120,
    "exclude": [
      "./deno_cache/",
      "./node_modules/",
      "./out/",
      "./package-lock.json",
      "./bundling/bundles",
      "./test/cov_profile"
    ]
  },
  "tasks": {
    "check": "deno lint && deno fmt --check",
    "test": "deno test --allow-env",
    "tidy": "deno fmt && deno task check"
  }
}
